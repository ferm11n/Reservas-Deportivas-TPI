{
  "expo": {
    "name": "Reservas Deportivas Villaguay",
    "slug": "reservas-deportivas-villaguay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "reservasdeportivas",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.villaguay.reservasdeportivas",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.villaguay.reservasdeportivas",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app requiere la cámara para escanear el código QR en la entrada de las canchas.",
        "NSLocationWhenInUseUsageDescription": "Esta app necesita tu ubicación para calcular la distancia a los predios deportivos.",
        "NSFaceIDUsageDescription": "Esta app utiliza Face ID para el reingreso seguro del encargado."
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sqlite",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Permite grabar observaciones de audio sobre el estado de una cancha.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite acceder a la cámara para escanear códigos QR en la puerta."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite mostrar tu distancia hacia los predios deportivos en el mapa."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite autenticarte rápidamente mediante huella o rostro."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-image",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dcfe7f77-fb2a-426f-9bad-d9da3ee004c8"
      }
    }
  }
}
